{
  "name": "mcp-shell",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch mcp-shell.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:server": "rm -rf dist/server && tsc -p tsconfig.server.json && cp -R bin dist/server/bin",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node dist/server/mcp-shell.js",
    "test": "npm run test:server && npm run test:web",
    "test:server": "tsx --test test/*.test.ts",
    "test:web": "NODE_ENV=test vitest run --config web/vitest.config.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "check:web-boundaries": "node scripts/check-web-boundaries.mjs",
    "verify": "npm run typecheck && npm test && npm run check:web-boundaries && npm run build && bun archdoc.ts check && git diff --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "^1.3.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
